---
import { order, site } from '../lib/content';

const store = order.store;
---

<!-- 微信小商店外链卡（REQ-021/027/028）：纯外链，站内无任何支付代码 -->
<div class="card-surface overflow-hidden">
  <div class="border-b border-border-line p-5 md:p-6">
    <h2 class="section-title-glow text-lg font-bold md:text-xl">
      去微信小商店下单
    </h2>
    <p class="mt-2 text-sm text-text-secondary">
      标准套餐直接下单付款，方便快捷
    </p>
  </div>

  <div class="p-5 md:p-6">
    <!-- 主按钮：新窗口打开第三方店铺（REQ-021/028） -->
    <a
      href={store.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-[var(--radius-btn)] px-6 py-3 text-base font-bold text-white btn-primary-glow btn-sweep"
      aria-label={`${store.title}（将在新窗口打开）`}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8.7 4C5 4 2 6.5 2 9.6c0 1.7.9 3.3 2.3 4.3l-.6 1.9c-.1.3.2.6.5.4l2.1-1.3c.8.2 1.6.3 2.4.3.3 0 .6 0 .9-.1-.1-.5-.1-1 0-1.5 0-2.7 2.4-4.8 5.4-4.8h.4C14.6 5.8 11.9 4 8.7 4zM6.4 7.6c.7 0 1.2.5 1.2 1.2S7 10 6.4 10s-1.2-.5-1.2-1.2.5-1.2 1.2-1.2zm4.6 0c.7 0 1.2.5 1.2 1.2s-.5 1.2-1.2 1.2-1.2-.5-1.2-1.2.5-1.2 1.2-1.2zM22 14.4c0-2.6-2.6-4.7-5.8-4.7s-5.8 2.1-5.8 4.7 2.6 4.7 5.8 4.7c.7 0 1.4-.1 2-.3l1.8 1.1c.3.2.6-.1.5-.4l-.5-1.6c1.3-.9 2-2 2-3.5zm-7.7-.6c-.6 0-1-.5-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1zm3.8 0c-.6 0-1-.5-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1z" />
      </svg>
      {store.title}
      <svg class="ext-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
      </svg>
    </a>

    <!-- 平台担保说明（REQ-021 提示文案） -->
    <p class="mt-4 flex items-start gap-2 rounded-[var(--radius-btn)] border border-success/25 bg-success/5 p-3 text-xs text-text-secondary">
      <svg class="mt-0.5 shrink-0 text-success" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21.8 10A10 10 0 1 1 17 3.34" />
        <path d="m9 11 3 3L22 4" />
      </svg>
      {store.note}
    </p>
  </div>

  <!-- 微信直联通道（下单页三通道之一） -->
  <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 border-t border-border-line bg-bg-surface/60 p-5">
    <img
      src={site.wechat.qrImage}
      alt={site.wechat.qrAlt}
      width="88"
      height="88"
      loading="lazy"
      class="w-16 rounded-[var(--radius-btn)] border border-border-line bg-white p-1"
    />
    <div>
      <p class="text-sm font-medium text-text-primary">有问题？加微信聊聊</p>
      <p class="mt-0.5 text-xs text-text-muted">
        微信号 <span class="select-all text-text-secondary">{site.wechat.wechatId}</span>
      </p>
    </div>
    <button
      type="button"
      data-open-wechat
      class="inline-flex min-h-11 shrink-0 items-center rounded-[var(--radius-btn)] px-4 py-2 text-sm btn-secondary-glow"
    >
      看二维码
    </button>
  </div>
</div>