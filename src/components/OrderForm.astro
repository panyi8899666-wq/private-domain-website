---
import { site } from '../lib/content';
---

<!-- 微信发需求引导卡（纯微信直联：不渲染问卷 iframe，避免空白） -->
<div class="card-surface overflow-hidden">
  <div class="border-b border-border-line p-5 md:p-6">
    <h2 class="section-title-glow text-lg font-bold md:text-xl">
      微信发需求
    </h2>
    <p class="mt-2 text-sm text-text-secondary">
      类型/规格/数量/位置一次说清，微信回复最快
    </p>
  </div>

  <div class="p-5 md:p-6">
    <!-- 微信号大字号居中 + 复制按钮 -->
    <div class="rounded-[var(--radius-btn)] border border-accent-glow/50 bg-accent-glow/5 p-6 text-center">
      <p class="text-xs text-text-muted">微信号（即手机号）</p>
      <p class="mt-2 select-all text-2xl font-bold tracking-wide text-accent-glow text-neon md:text-3xl">
        {site.wechat.wechatId}
      </p>
      <button
        type="button"
        data-copy-wechat-form
        data-wechat-id={site.wechat.wechatId}
        class="mt-4 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-[var(--radius-btn)] px-5 py-2.5 text-sm font-bold text-white btn-primary-glow btn-sweep"
        aria-label={`复制微信号 ${site.wechat.wechatId}`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
        </svg>
        <span data-copy-wechat-form-label>复制微信号</span>
      </button>
      <p class="mt-3 text-xs text-text-muted">已有微信直接搜索上面号码添加</p>
    </div>

    <!-- 加好友二维码 + 底部提示 -->
    <div class="mt-5 flex flex-col items-center gap-3">
      <img
        src={site.wechat.qrImage}
        alt={site.wechat.qrAlt}
        width="200"
        height="200"
        loading="lazy"
        class="w-44 rounded-[var(--radius-btn)] border border-border-line bg-white p-2"
      />
      <p class="text-center text-xs text-text-muted">
        扫码加微信，直接发需求文字或图片，1 小时内响应报价
      </p>
    </div>
  </div>
</div>

<script>
  // 复制微信号（与 StoreCard 各自独立，选择器用 data-copy-wechat-form 避免冲突）
  (function () {
    var btn = document.querySelector('[data-copy-wechat-form]');
    if (!btn) return;

    var wechatId = btn.getAttribute('data-wechat-id') || '';
    var label = btn.querySelector('[data-copy-wechat-form-label]');
    var defaultText = '复制微信号';

    function restore() {
      setTimeout(function () {
        if (label) label.textContent = defaultText;
      }, 1600);
    }

    function succeed() {
      if (label) label.textContent = '已复制 ✓';
      restore();
    }

    function legacyCopy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      var ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (_) {
        ok = false;
      }
      document.body.removeChild(ta);
      done(ok);
    }

    btn.addEventListener('click', function () {
      if (!wechatId) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard
          .writeText(wechatId)
          .then(succeed)
          .catch(function () {
            legacyCopy(wechatId, function (ok) {
              ok ? succeed() : restore();
            });
          });
      } else {
        legacyCopy(wechatId, function (ok) {
          ok ? succeed() : restore();
        });
      }
    });
  })();
</script>