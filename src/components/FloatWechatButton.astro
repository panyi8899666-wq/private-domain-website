---
import { site } from '../lib/content';
---

<!-- 悬浮微信按钮（REQ-003）：右下角常驻，滚动不消失 -->
<button
  type="button"
  class="float-wechat-btn"
  data-wechat-float
  aria-label={`联系微信 ${site.wechat.wechatId}`}
  aria-haspopup="dialog"
>
  <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M8.7 4C5 4 2 6.5 2 9.6c0 1.7.9 3.3 2.3 4.3l-.6 1.9c-.1.3.2.6.5.4l2.1-1.3c.8.2 1.6.3 2.4.3.3 0 .6 0 .9-.1-.1-.5-.1-1 0-1.5 0-2.7 2.4-4.8 5.4-4.8h.4C14.6 5.8 11.9 4 8.7 4zM6.4 7.6c.7 0 1.2.5 1.2 1.2S7 10 6.4 10s-1.2-.5-1.2-1.2.5-1.2 1.2-1.2zm4.6 0c.7 0 1.2.5 1.2 1.2s-.5 1.2-1.2 1.2-1.2-.5-1.2-1.2.5-1.2 1.2-1.2zM22 14.4c0-2.6-2.6-4.7-5.8-4.7s-5.8 2.1-5.8 4.7 2.6 4.7 5.8 4.7c.7 0 1.4-.1 2-.3l1.8 1.1c.3.2.6-.1.5-.4l-.5-1.6c1.3-.9 2-2 2-3.5zm-7.7-.6c-.6 0-1-.5-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1zm3.8 0c-.6 0-1-.5-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1z"
    />
  </svg>
</button>

<!-- 微信二维码弹层（桌面端直接弹层 / 移动端唤起失败降级弹层） -->
<div
  class="wechat-modal"
  data-wechat-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="wechat-modal-title"
  aria-hidden="true"
>
  <div class="wechat-modal-card relative text-center">
    <button
      type="button"
      class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-[var(--radius-btn)] text-text-secondary transition hover:text-text-primary"
      data-wechat-close
      aria-label="关闭"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>

    <span
      class="inline-flex items-center rounded-[var(--radius-tag)] border border-accent-glow/50 px-3 py-1 text-xs text-accent-glow text-neon"
      >微信扫码 · 免费咨询报价</span
    >
    <h3 id="wechat-modal-title" class="mt-3 text-lg font-bold text-text-primary">
      添加潘工微信
    </h3>
    <img
      src={site.wechat.qrImage}
      alt={site.wechat.qrAlt}
      width="280"
      height="280"
      class="mx-auto mt-4 w-56 rounded-[var(--radius-card)] border border-border-line bg-white p-1"
    />
    <p class="mt-4 text-xs text-text-secondary">微信扫一扫识别二维码加我</p>
    <p class="mt-1 text-xs text-text-muted">
      或搜索微信号：
      <span class="select-all font-medium text-text-primary">
        {site.wechat.wechatId}
      </span>
    </p>
    <button
      type="button"
      class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-[var(--radius-btn)] px-5 py-2.5 text-sm font-semibold btn-primary-glow"
      data-wechat-copy
      data-wechat-id={site.wechat.wechatId}
    >
      复制微信号
    </button>
    <p class="mt-3 text-xs text-text-muted">
      长按页脚二维码图片也可识别添加
    </p>
  </div>
</div>

<script>
  (function () {
    var btn = document.querySelector('[data-wechat-float]');
    var modal = document.querySelector('[data-wechat-modal]');
    var closeBtn = document.querySelector('[data-wechat-close]');
    var copyBtn = document.querySelector('[data-wechat-copy]');
    if (!btn || !modal) return;

    function isWechatUA() {
      return /MicroMessenger/i.test(navigator.userAgent || '');
    }
    function isMobile() {
      return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent || '');
    }
    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    /* 点击悬浮按钮：三态逻辑（design §2.8.2） */
    btn.addEventListener('click', function () {
      if (isWechatUA()) {
        openModal(); // 微信内置浏览器直接弹层
        return;
      }
      if (isMobile()) {
        // 尝试唤起微信 App，2.5s 未切后台则降级弹层
        var beforeHidden = document.hidden;
        window.location.href = 'weixin://';
        setTimeout(function () {
          if (document.hidden === beforeHidden) {
            openModal();
          }
        }, 2500);
        return;
      }
      openModal(); // 桌面端直接弹层
    });

    /* 全站「加微信」按钮（带 data-open-wechat 签名）统一触发弹层 */
    document.addEventListener('click', function (e) {
      var target = e.target;
      if (target instanceof Element && target.closest('[data-open-wechat]')) {
        e.preventDefault();
        openModal();
      }
    });

    /* 关闭：按钮 / 遮罩背景 / Esc */
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    /* 复制微信号（navigator.clipboard + execCommand 老式回退） */
    function legacyCopy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      var ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (_) {
        ok = false;
      }
      document.body.removeChild(ta);
      done(ok);
    }
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = copyBtn.getAttribute('data-wechat-id') || '';
        var restore = function () {
          setTimeout(function () {
            copyBtn.textContent = '复制微信号';
          }, 1600);
        };
        var succeed = function () {
          copyBtn.textContent = '已复制 ✓';
          restore();
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard
            .writeText(text)
            .then(succeed)
            .catch(function () {
              legacyCopy(text, function (ok) {
                ok ? succeed() : restore();
              });
            });
        } else {
          legacyCopy(text, function (ok) {
            ok ? succeed() : restore();
          });
        }
      });
    }

    /* 页脚避让：滚动到页脚区按钮自动上移 12px（REQ-003 不遮挡底部联系方式） */
    var footer = document.querySelector('footer');
    var isUp = false;
    var applyUp = function (up) {
      if (up !== isUp) {
        isUp = up;
        btn.classList.toggle('is-up', up);
      }
    };
    if (footer && 'IntersectionObserver' in window) {
      var footerIO = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            applyUp(entry.isIntersecting);
          });
        },
        { root: null, threshold: 0.08 }
      );
      footerIO.observe(footer);
    } else if (footer) {
      var onScroll = function () {
        var rect = footer.getBoundingClientRect();
        applyUp(rect.top < window.innerHeight);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  })();
</script>