---
interface Step {
  step: string;
  title: string;
  desc: string;
}

interface Props {
  /** 流程步骤数组（首页 4 步 / 下单页 5 步，双模式共用同一组件，REQ-010/022） */
  steps: Step[];
  /** 末端 CTA 文案（可选，缺省不渲染） */
  ctaText?: string;
  /** 末端 CTA 链接（可选） */
  ctaHref?: string;
}

const { steps, ctaText, ctaHref } = Astro.props;

const isFive = steps.length >= 5;
---

<!-- 接单流程时间轴（REQ-010 首页 4 步 / REQ-022 下单页 5 步） -->
<section
  class="section-block bg-bg-surface/40"
  aria-labelledby="process-title"
>
  <div class="container-site">
    <div class="text-center" data-reveal>
      <h2 id="process-title" class="section-title-glow text-2xl md:text-4xl">
        接单流程
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-text-secondary">
        咨询到交付全程透明，每一步都有交代
      </p>
    </div>

    <ol
      class:list={[
        'mt-10 grid gap-6',
        isFive
          ? 'sm:grid-cols-2 lg:grid-cols-5'
          : 'sm:grid-cols-2 lg:grid-cols-4',
      ]}
      data-reveal-group
    >
      {
        steps.map((step, index) => (
          <li
            class="card-surface relative p-6"
            data-reveal-item
            style={`--reveal-delay:${index * 80}ms`}
          >
            <!-- 发光描边连接线（桌面端横向） -->
            {index < steps.length - 1 && (
              <span
                class="process-line absolute left-full top-8 hidden w-[calc(100%-16px)] lg:block"
                aria-hidden="true"
              ></span>
            )}
            <span class="process-step-num" aria-hidden="true">{step.step}</span>
            <h3 class="mt-3 text-lg font-bold text-text-primary">
              {step.title}
            </h3>
            <p class="mt-2 text-sm text-text-secondary">{step.desc}</p>
          </li>
        ))
      }
    </ol>

    {
      ctaText && ctaHref && (
        <div class="mt-10 text-center" data-reveal>
          <a
            href={ctaHref}
            class="inline-flex min-h-12 items-center gap-2 rounded-[var(--radius-btn)] px-8 py-3 text-base btn-primary-glow btn-sweep"
          >
            {ctaText}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>