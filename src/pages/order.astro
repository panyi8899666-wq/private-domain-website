---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrderForm from '../components/OrderForm.astro';
import StoreCard from '../components/StoreCard.astro';
import OrderProcess from '../components/OrderProcess.astro';
import CTABanner from '../components/CTABanner.astro';
import { order } from '../lib/content';
---

<BaseLayout
  pageTitle="下单与咨询：加微信免费报价|微信直联下单"
  pageDescription="加微信发需求，1对1免费报价；微信沟通确认后扫码支付定金，全程微信直联，简单放心。"
>
  <!-- 页头 -->
  <section class="bg-light-spots py-14 md:py-20" aria-labelledby="order-title">
    <div class="container-site text-center">
      <span class="inline-flex rounded-full border border-accent-glow/45 bg-accent-glow/10 px-4 py-1.5 text-sm text-accent-glow text-neon" data-reveal>
        下单 · 咨询 · 支付
      </span>
      <h1 id="order-title" class="text-glow-gradient mx-auto mt-4 text-3xl font-extrabold md:text-5xl" data-reveal style="--reveal-delay:80ms">
        {order.pageTitle}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-text-secondary" data-reveal style="--reveal-delay:160ms">
        {order.intro}
      </p>
    </div>
  </section>

  <!-- 主体：桌面 2 列（表单 + 小商店）/ 移动单列堆叠（REQ-020/021） -->
  <div class="container-site section-block">
    <div class="grid gap-8 lg:grid-cols-2">
      <OrderForm />
      <StoreCard />
    </div>
    <!-- 底部提示：三通道并存 -->
    <p class="mt-6 text-center text-xs text-text-muted">
      加微信发需求 → 确认报价 → 扫码支付定金 → 制作交付，全程微信直联
    </p>
  </div>

  <!-- 接单流程 5 步（REQ-022） -->
  <OrderProcess />

  <!-- 页底 CTA 横幅（REQ-002：疑问兜底出口） -->
  <CTABanner
    title="还有疑问？加微信直接沟通"
    subtitle="设计、材质、工期、价格，任何问题都欢迎随时来问"
  />
</BaseLayout>